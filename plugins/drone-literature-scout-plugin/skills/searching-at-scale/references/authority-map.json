  "conflict_resolutions": [
    {
      "topic": "quick_direct versus saturation",
      "resolution": "quick_direct may answer one stable fact directly but may not claim global market search_saturated; that claim still requires three verified rounds."
    },
    {
      "topic": "bulk_unavailable scope",
      "resolution": "bulk_unavailable hard-stops the current backend bulk stage; global discovery may continue only after another backend passes fresh preflight, otherwise incomplete_blocked."
    },
    {
      "topic": "JD pagination route",
      "resolution": "experimental_url remains the promoted default; human_flow is the navigation-context alternative used when platform evidence calls for it."
    },
    {
      "topic": "JD slow-lane rate",
      "resolution": "one card per second remains the target and disclosure metric, while acceptance uses the full allowed wall window, complete fields, minimum 60 candidates, and truthful observed rate rather than a continuous absolute gate."
    },
    {
      "topic": "ten-minute stop versus final success",
      "resolution": "ten_minute_limit stops discovery; final success still requires RUN_ACCEPTANCE and, for marketplace runs, acceptance_passed. Bounded runs may report partial or incomplete."
    },
    {
      "topic": "configurable JD window",
      "resolution": "the four standard run types remain capped at 600 seconds; a longer configurable window is restricted to a separately declared standalone deep experiment and never changes standard-run acceptance."
    }
