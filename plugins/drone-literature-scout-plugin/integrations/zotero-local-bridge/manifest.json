{
  "manifest_version": 2,
  "name": "Zotero Local Bridge",
  "version": "2.3.0",
  "description": "Provides a narrow local bridge for Obsidian links and controlled Zotero annotation operations.",
  "homepage_url": "https://www.zotero.org/support/dev/client_coding/plugin_development",
  "applications": {
    "zotero": {
      "id": "obsidian-link-bridge@read-paper-analysis-highlight.local",
      "update_url": "https://obsidian-link.invalid/updates.json",
